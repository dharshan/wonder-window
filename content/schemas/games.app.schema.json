{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "app-games.v1",
 "title": "PLAY games files loaded by the app (games.json, catalogue_games.json); deep rules live in tools/content/validate_games.py",
 "type": "object",
 "required": [
  "games"
 ],
 "properties": {
  "games": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "icon",
     "levels"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "catalogue_id": {
      "type": "string",
      "pattern": "^WW-[0-9]{3}$"
     },
     "name": {
      "type": "string"
     },
     "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "level",
        "rounds"
       ],
       "properties": {
        "level": {
         "type": "integer"
        },
        "rounds": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "id"
          ],
          "properties": {
           "id": {
            "type": "string"
           },
           "variant": {
            "type": "string"
           },
           "prompt": {
            "type": "string"
           },
           "say": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "merged_modes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "alias_of",
     "levels"
    ]
   }
  },
  "aliases": {
   "type": "object"
  }
 }
}
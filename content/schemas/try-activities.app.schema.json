{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "try-activities.v1",
 "title": "TRY activities file loaded by the app (app/src/main/assets/try_activities.json)",
 "type": "object",
 "required": [
  "schema_version",
  "families",
  "activities"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "families": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "icon",
     "color"
    ]
   }
  },
  "lines": {
   "type": "object"
  },
  "activities": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "schema_version",
     "activity_id",
     "title",
     "short_description",
     "say",
     "pic",
     "category",
     "recommended_age_bands",
     "duration_minutes",
     "screen_intro_seconds",
     "materials",
     "child_steps",
     "adult_support",
     "safety_notes",
     "adaptations_by_age",
     "accessibility_adaptations",
     "video_topic_tags",
     "language_variants",
     "safety_review",
     "safety_status",
     "content_status"
    ],
    "properties": {
     "activity_id": {
      "type": "string",
      "pattern": "^TRY-[A-Z]+-[0-9]{3}$"
     },
     "category": {
      "enum": [
       "move_and_play",
       "create_and_make",
       "nature_and_notice",
       "think_and_discover",
       "help_and_everyday",
       "family_and_connect",
       "calm_and_mindful"
      ]
     },
     "recommended_age_bands": {
      "type": "array",
      "items": {
       "enum": [
        "3-4",
        "5-6",
        "7-8",
        "9-10"
       ]
      },
      "minItems": 1
     },
     "duration_minutes": {
      "type": "object",
      "required": [
       "min",
       "max"
      ]
     },
     "screen_intro_seconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 60
     },
     "child_steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
       "type": "object",
       "required": [
        "pic",
        "text",
        "say"
       ],
       "properties": {
        "pic": {
         "type": "string"
        },
        "text": {
         "type": "string",
         "maxLength": 40
        },
        "say": {
         "type": "string"
        }
       }
      }
     },
     "adult_support": {
      "enum": [
       "none",
       "optional",
       "recommended",
       "required"
      ]
     },
     "safety_review": {
      "type": "object",
      "additionalProperties": {
       "enum": [
        "none",
        "mitigated",
        "present"
       ]
      }
     },
     "safety_status": {
      "enum": [
       "approved",
       "parent_supervision_required",
       "needs_review",
       "rejected"
      ]
     },
     "content_status": {
      "enum": [
       "draft",
       "reviewed",
       "published"
      ]
     }
    }
   }
  }
 }
}
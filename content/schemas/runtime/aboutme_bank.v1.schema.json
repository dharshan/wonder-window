{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/dharshan/wonder-window/content/schemas/runtime/aboutme_bank.v1.schema.json",
 "title": "aboutme_bank.json - Explorer Passport items (array, unversioned)",
 "x-status": "current",
 "x-file": "app/src/main/assets/aboutme_bank.json",
 "description": "Items are filled from the parent's local settings at runtime; the public build has no address or phone items.",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^me-[0-9]{3}$"
   },
   "domain": {
    "const": "aboutme"
   },
   "level": {
    "type": "integer"
   },
   "format": {
    "type": "string",
    "minLength": 1
   },
   "prompt": {
    "type": "string",
    "minLength": 1
   },
   "say": {
    "type": "string",
    "minLength": 1
   },
   "big": {
    "type": "string"
   },
   "choices": {
    "type": "array"
   },
   "answer": {
    "type": [
     "integer",
     "null"
    ]
   },
   "source": {
    "type": "string",
    "not": {
     "pattern": "phone|address"
    }
   },
   "check": {
    "type": "string",
    "minLength": 1
   },
   "choices_from": {
    "type": [
     "string",
     "null"
    ]
   },
   "save_as": {
    "type": [
     "string",
     "null"
    ]
   },
   "tier": {
    "type": "string",
    "minLength": 1
   },
   "counts": {
    "type": "boolean"
   },
   "unlock": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": true
   },
   "why": {
    "type": "string",
    "minLength": 1
   },
   "hint": {
    "type": "string",
    "minLength": 1
   },
   "say_ok": {
    "type": "string",
    "minLength": 1
   },
   "show_answer": {
    "type": "boolean"
   },
   "passport_page": {
    "type": "integer"
   },
   "success": {
    "type": "string",
    "minLength": 1
   },
   "reask_after_days": {
    "type": "integer"
   },
   "personalise": {
    "type": "string",
    "minLength": 1
   },
   "mode": {
    "type": "string",
    "minLength": 1
   }
  },
  "required": [
   "id",
   "domain",
   "level",
   "format",
   "prompt",
   "say",
   "big",
   "choices",
   "answer",
   "source",
   "check",
   "tier",
   "counts",
   "unlock",
   "why",
   "say_ok",
   "passport_page",
   "success"
  ],
  "additionalProperties": false
 }
}

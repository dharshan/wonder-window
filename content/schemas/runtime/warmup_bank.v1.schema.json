{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/dharshan/wonder-window/content/schemas/runtime/warmup_bank.v1.schema.json",
 "title": "warmup_bank.json - warm-up multiple-choice items (array, unversioned)",
 "x-status": "current",
 "x-file": "app/src/main/assets/warmup_bank.json",
 "description": "Optional standalone warm-up questions. They never set, unlock or extend screen time (issue #1, point 6).",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^[a-z]+-[0-9]{3}$"
   },
   "domain": {
    "type": "string",
    "minLength": 1
   },
   "level": {
    "enum": [
     1,
     2,
     3
    ]
   },
   "prompt": {
    "type": "string",
    "minLength": 1
   },
   "say": {
    "type": "string",
    "minLength": 1
   },
   "big": {
    "type": "string"
   },
   "choices": {
    "type": "array",
    "items": {
     "type": "string",
     "minLength": 1
    },
    "minItems": 2,
    "maxItems": 4
   },
   "answer": {
    "type": "integer"
   },
   "why": {
    "type": "string",
    "minLength": 1
   }
  },
  "required": [
   "id",
   "domain",
   "level",
   "prompt",
   "say",
   "big",
   "choices",
   "answer",
   "why"
  ],
  "additionalProperties": false
 }
}
